From ffeb32b2d2caecc2111bfd93b6919dc4f09d3c2d Mon Sep 17 00:00:00 2001
From: Laszlo Gombos <laszlo.gombos@gmail.com>
Date: Sun, 14 Apr 2024 09:27:38 -0400
Subject: [PATCH] fix(dracut-init.sh): force to perform the actual action

diff --git a/modules.d/98systemd/dracut-emergency.sh b/modules.d/98systemd/dracut-emergency.sh
index b3e8d087..37c965d1 100755
--- a/modules.d/98systemd/dracut-emergency.sh
+++ b/modules.d/98systemd/dracut-emergency.sh
@@ -41,11 +41,14 @@ fi
 
 case "$_emergency_action" in
     reboot)
-        reboot || exit 1;;
+        reboot -f || exit 1
+        ;;
     poweroff)
-        poweroff || exit 1;;
+        poweroff -f || exit 1
+        ;;
     halt)
-        halt || exit 1;;
+        halt -f || exit 1
+        ;;
 esac
 
 exit 0
diff --git a/modules.d/99base/dracut-lib.sh b/modules.d/99base/dracut-lib.sh
index 0a587ae6..b97b8906 100755
--- a/modules.d/99base/dracut-lib.sh
+++ b/modules.d/99base/dracut-lib.sh
@@ -1121,11 +1121,14 @@ emergency_shell()
 
     case "$_emergency_action" in
         reboot)
-            reboot || exit 1;;
+            reboot -f || exit 1
+            ;;
         poweroff)
-            poweroff || exit 1;;
+            poweroff -f || exit 1
+            ;;
         halt)
-            halt || exit 1;;
+            halt -f || exit 1
+            ;;
     esac
 }
 
